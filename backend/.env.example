# 이 파일을 복사해서 .env 로 저장하면 백엔드가 읽어들입니다.
#   cp .env.example .env
# .env 는 git 에 올라가지 않습니다(.gitignore).
#
# ── 로컬 개발이면 아래 4줄 그대로 두면 됩니다. ──
# ── Render 배포 시엔 Render 대시보드의 Environment 에 같은 이름으로 값을 넣습니다
#    (DATABASE_URL 은 Render Postgres 가 자동 연결). ──

# 데이터베이스. 로컬은 SQLite 파일, 배포는 PostgreSQL 주소.
DATABASE_URL=sqlite:///./app.db
# 배포 예: DATABASE_URL=postgresql://user:pass@host:5432/dbname

# 브라우저 CORS 허용 주소 (쉼표로 여러 개). 프론트엔드가 배포된 주소.
FRONTEND_ORIGINS=http://localhost:5173
# 배포 예: FRONTEND_ORIGINS=https://mmz-scheduler.vercel.app

# QR 코드/공유 링크에 쓸 공개 주소 (직원이 접속할 프론트엔드 주소).
PUBLIC_BASE_URL=http://localhost:5173
# 배포 예: PUBLIC_BASE_URL=https://mmz-scheduler.vercel.app

# (선택) 관리자 화면 보호. 둘 다 채우면 /api 에 로그인창(기본 인증)이 뜹니다.
# 직원 QR 조회(/api/public/*)와 /health 는 계속 열려 있습니다.
ADMIN_USER=
ADMIN_PASS=
