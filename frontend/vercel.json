{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://mmz-scheduler-api.onrender.com/api/:path*"
    },
    { "source": "/staff-login", "destination": "/staff-login.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
